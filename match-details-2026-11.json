ro_id": 16, "player_slot": 131, "kills": 7, "deaths": 4, "assists": 16, "gold_per_min": 597, "xp_per_min": 769, "last_hits": 297, "denies": 8, "net_worth": 23260, "hero_damage": 28903, "tower_damage": 3548, "hero_healing": 125, "obs_placed": 0, "sen_placed": 0, "stuns": 39.66738, "level": 24, "hero_name": "沙王", "position": "3号位", "positionSource": "分路推断", "rating": 60.7}, {"account_id": 182965526, "personaname": "......", "name": null, "hero_id": 86, "player_slot": 132, "kills": 9, "deaths": 5, "assists": 18, "gold_per_min": 404, "xp_per_min": 494, "last_hits": 67, "denies": 0, "net_worth": 14813, "hero_damage": 16398, "tower_damage": 332, "hero_healing": 2833, "obs_placed": 9, "sen_placed": 15, "stuns": 41.26636, "level": 19, "hero_name": "拉比克", "position": "4号位", "positionSource": "分路推断", "rating": 52.9}], "report": {"title": "夜魇获胜 · 41:11", "overview": "夜魇获胜，比赛历时41:11；最终击杀数为天辉28、夜魇37。经济节奏：10分钟夜魇领先249经济；20分钟夜魇领先4,222经济；30分钟夜魇领先3,541经济；40分钟夜魇领先17,547经济。", "timeline": [{"time": "30:04—30:46", "label": "关键交战", "text": "夜魇在此交战时段内阵亡0人次，对方阵亡4人次。"}, {"time": "31:33", "label": "肉山收益", "text": "夜魇的宰（虚空假面）取得不朽之守护。"}, {"time": "38:25—39:20", "label": "关键交战", "text": "夜魇在此交战时段内阵亡1人次，对方阵亡4人次。双方合计投入2次买活。"}, {"time": "39:15", "label": "兵营告破", "text": "天辉中路近战与远程兵营均已被摧毁。"}, {"time": "39:59", "label": "兵营告破", "text": "天辉上路近战与远程兵营均已被摧毁。"}, {"time": "40:27—41:06", "label": "关键交战", "text": "夜魇在此交战时段内阵亡0人次，对方阵亡3人次。"}, {"time": "41:12", "label": "比赛结束", "text": "天辉遗迹被摧毁，夜魇赢下本场比赛。"}], "highlights": [{"label": "本场最佳", "text": "♠jdhhhhhhhh（殁境神蚀者）交出12杀3死14助攻，参团率70.3%，英雄伤害28,116。本场评分69.5。"}, {"label": "胜方输出", "text": "卜一本（沙王）交出7杀4死16助攻，参团率62.2%，英雄伤害28,903。"}, {"label": "建筑贡献", "text": "宰（虚空假面）打出9,102点建筑伤害，为夜魇最高。"}, {"label": "对方表现", "text": "宇文逸（森海飞霞）交出10杀6死8助攻，参团率64.3%，英雄伤害24,562。英雄伤害为天辉最高。"}], "headline": "沙王零换四打开突破口，夜魇带盾连破两路取胜", "sections": [{"title": "", "paragraphs": ["沙王打出关键交战，虚空假面拿盾推进，殁境神蚀者在收尾阶段保持输出。夜魇在41分11秒以37∶28击败天辉，拿下了一场人头差距不算悬殊、后段建筑收益却迅速拉开的比赛。"]}, {"title": "前30分钟仍有来回，夜魇等待扩大领先", "paragraphs": ["10分钟，夜魇经济只领先249；到20分钟，领先来到4,222，但25分钟和30分钟仍分别只有约3,400与3,500。天辉没有在中段被彻底甩开，双方仍持续交战。", "天辉也打出过有利交换。16:07—16:53，天辉阵亡一人，夜魇阵亡两人，玛西贡献1,719点伤害。夜魇虽然掌握经济领先，却还没有把资源差距转化成持续扩大的推进成果。"]}, {"title": "30分钟零换四，拿盾之后三路二塔接连告破", "paragraphs": ["30:04—30:46，比赛出现了关键突破：天辉倒下四人，夜魇没有阵亡。卜一本的沙王打出4,212点伤害，为这段交战最高；殁境神蚀者贡献2,257点。夜魇随后在30:53拆掉下路二塔，31:33拿下肉山，虚空假面取得不朽之守护。", "带盾之后，夜魇的建筑收益开始加快。32:48上路二塔告破，33:46中路二塔被拆，34:31中路高地塔也失守。35分钟，夜魇经济领先扩大至8,624，比赛从中段的反复交换转向了天辉基地前的防守。"]}, {"title": "天辉两人买活，夜魇仍连续拆掉中上两路", "paragraphs": ["38:25—39:20，天辉投入森海飞霞和米拉娜两次买活，依然累计阵亡四人次，夜魇阵亡一人。殁境神蚀者打出4,986点伤害且没有阵亡，夜魇在这段交战中继续取得有利结果。", "天辉中路远程、近战兵营在39:09和39:15先后被拆；39:59，上路两座兵营也全部告破。40分钟，夜魇经济领先达到17,547。最后一段交战，夜魇再次打出无人阵亡、天辉三人阵亡的结果，随后完成终结。"]}, {"title": "一个只有1杀的虚空假面，却承担了最多建筑输出", "paragraphs": ["夜魇的伤害主力是沙王和殁境神蚀者：前者打出28,903点英雄伤害，后者以12杀3死14助攻、28,116点伤害收官。沙王在30分钟的零换四中打出最高伤害，殁境神蚀者则在后期两段胜利交战里保持存活，分别贡献4,986和2,226点伤害。", "虚空假面的终场战绩只有1杀7死18助攻，却打出全场最高的9,102点建筑伤害。他拿到不朽之守护，并完成天辉中路近战兵营和遗迹的最后一击。单看击杀数，他并不显眼；把拿盾和建筑输出连起来看，他的推进贡献就清楚得多。", "电磁弹射器的魅惑魔女也打出7,408点建筑伤害，参与了上路二塔和中路远程兵营的拆除。天辉一侧，宇文逸的森海飞霞拿到10杀、24,562点伤害，仍有个人亮点，但夜魇在30分钟后连赢关键交战，并把收益集中兑现成了两路兵营和最终胜利。"]}], "verdict": "", "reportVersion": 3, "editorialReviewed": true}}, "9075977787": {"match_id": 9075977787, "leagueid": 18113, "start_time": 1793801688, "duration": 3667, "radiant_win": true, "radiant_score": 43, "dire_score": 38, "version": null, "players": [{"account_id": 148798662, "personaname": "宰", "name": null, "hero_id": 44, "player_slot": 0, "kills": 7, "deaths": 7, "assists": 20, "gold_per_min": 641, "xp_per_min": 923, "last_hits": 575, "denies": 20, "net_worth": 37664, "hero_damage": 38137, "tower_damage": 5537, "hero_healing": 0, "obs_placed": null, "sen_placed": null, "stuns": null, "level": 29, "hero_name": "幻影刺客", "position": "1号位", "positionSource": "缺失分路暂归", "rating": 59.3}, {"account_id": 135611899, "personaname": "♠jdhhhhhhhh", "name": null, "hero_id": 113, "player_slot": 1, "kills": 15, "deaths": 7, "assists": 19, "gold_per_min": 993, "xp_per_min": 1222, "last_hits": 81