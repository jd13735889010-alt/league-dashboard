": 327, "xp_per_min": 510, "last_hits": 110, "denies": 2, "net_worth": 12563, "hero_damage": 11106, "tower_damage": 0, "hero_healing": 1610, "obs_placed": 13, "sen_placed": 24, "stuns": 0, "level": 22, "hero_name": "不朽尸王", "position": "4号位", "positionSource": "分路推断", "rating": 43.8}], "report": {"title": "天辉获胜 · 52:06", "overview": "天辉获胜，比赛历时52:06；最终击杀数为天辉57、夜魇24。经济节奏：10分钟天辉领先1,064经济；20分钟天辉领先2,333经济；30分钟天辉领先3,244经济；40分钟天辉领先8,479经济；50分钟天辉领先15,646经济。", "timeline": [{"time": "14:12—14:49", "label": "关键交战", "text": "天辉在此交战时段内阵亡0人次，对方阵亡4人次。"}, {"time": "31:09—31:51", "label": "关键交战", "text": "天辉在此交战时段内阵亡0人次，对方阵亡4人次。双方合计投入1次买活。"}, {"time": "32:36", "label": "肉山收益", "text": "天辉的MOMO（风行者）取得不朽之守护。"}, {"time": "36:44", "label": "兵营告破", "text": "夜魇中路近战与远程兵营均已被摧毁。"}, {"time": "41:48—42:25", "label": "关键交战", "text": "天辉在此交战时段内阵亡0人次，对方阵亡3人次。"}, {"time": "45:59", "label": "兵营告破", "text": "夜魇下路近战与远程兵营均已被摧毁。"}, {"time": "46:20", "label": "兵营告破", "text": "夜魇上路远程兵营被摧毁。"}, {"time": "49:29", "label": "肉山收益", "text": "天辉的MOMO（风行者）取得不朽之守护。"}, {"time": "51:45", "label": "兵营告破", "text": "夜魇上路近战兵营被摧毁。"}, {"time": "52:06", "label": "比赛结束", "text": "夜魇遗迹被摧毁，天辉赢下本场比赛。"}], "highlights": [{"label": "本场最佳", "text": "雷电法王（暗夜魔王）交出14杀3死26助攻，参团率70.2%，英雄伤害39,341。本场评分69.6。"}, {"label": "胜方输出", "text": "MOMO（风行者）交出13杀6死18助攻，参团率54.4%，英雄伤害46,358。"}, {"label": "建筑贡献", "text": "MOMO（风行者）打出18,475点建筑伤害，为天辉最高。"}, {"label": "对方表现", "text": "♠jdhhhhhhhh（影魔）交出10杀10死7助攻，参团率70.8%，英雄伤害43,243。英雄伤害为夜魇最高。"}], "headline": "七次买活决战，天辉52分钟终结夜魇", "sections": [{"title": "", "paragraphs": ["52分钟的较量，最终在一轮七次买活的决战后结束。雷电法王的暗夜魔王交出14杀3死26助攻，MOMO的风行者包揽全场最高英雄伤害与建筑伤害，帮助天辉以57∶24击败夜魇。", "终场33个人头的差距，掩盖了这场比赛中段的胶着。26分钟时，天辉经济只领先136，前期积累的小幅优势几乎被抹平。夜魇仍握有影魔的输出和谜团的团战大招，比赛远没有进入收尾阶段。"]}, {"title": "干扰者买活，天辉在31分钟打出突破", "paragraphs": ["31:09开始的交战，成为天辉拉开差距的重要节点。干扰者在31:22买活，天辉在这段战斗中没有新增阵亡，夜魇则倒下四人。", "这波胜利由多人共同完成：潮汐交出大招，贡献3,268点伤害；夜魔打出2,892点伤害并存活下来；风行收获两次击杀。谜团虽然使用了黑洞，仍未能帮助夜魇扭转这波交战。", "天辉随后迅速兑现战果。32分钟，经济领先扩大到约6,000；32:35拿下肉山，风行带盾，继而拆掉夜魇中路二塔和高地塔。到36:44，中路两座兵营全部告破。从一次买活投入，到团战取胜，再到带盾破路，天辉终于把均势局面推进成了实质性的领先。"]}, {"title": "夜魇两度反击，比赛仍有悬念", "paragraphs": ["破掉中路，并没有让天辉顺利结束比赛。38:57的交战中，影魔打出4,454点伤害，取得两次击杀且保持存活，双方各阵亡两人。天辉的经济领先也从38分钟的约11,200，缩小到42分钟的约6,000。夜魇用这段抵抗表明，自己的团战输出依然足够制造威胁。", "天辉在42分钟重新赢下一波交战，随后拆掉下路兵营，但夜魇在46分钟又还以颜色：谜团贡献5,328点伤害，黑洞与冰女大招均有使用记录，夜魇以一人阵亡换掉天辉三人。", "这波反击为夜魇争取到了喘息机会，却没能改变中、下两路兵营已经丢失的局面。天辉仍有空间等待下一次肉山，而风行再次成为拿盾人选。"]}, {"title": "第二面盾之后，双方用七次买活争夺终局", "paragraphs": ["49:29，风行拿到第二次不朽之守护。随后到来的决战，比此前任何一波都更昂贵。50:21—51:14，双方合计投入七次买活。影魔打出7,936点伤害，谜团在这个交战窗口内留下两次黑洞使用记录；天辉一侧，风行贡献8,767点伤害且没有阵亡，成为这波持续交战中的关键输出点。", "夜魔阵亡后于51:01买活，继续投入最后的争夺。夜魇没能守住最后一路兵营。51:45，上路近战兵营被风行拆除，三路兵营至此全部告破。21秒后，夜魔摧毁夜魇遗迹，比赛定格在52:06。"]}, {"title": "夜魔的效率，风行的兑现", "paragraphs": ["雷电法王这场最突出的表现，是在频繁参与击杀的同时控制住了死亡。夜魔参与天辉40次击杀，参团率70.2%，全场只阵亡3次；31分钟打开局面、42分钟重新扩大优势的两波交战，他都贡献了输出并存活下来。", "风行则承担了另一份决定比赛结果的工作：全场46,358点英雄伤害、18,475点建筑伤害，两项均居首。两次拿盾、中路破路，以及最后决战中的持续输出，让她成为天辉把领先变成胜利的主要执行者。", "夜魇并非缺少抵抗。影魔以43,243点伤害领跑本方，谜团也曾用高伤害交战帮助队伍打退推进。但这场比赛最终属于能够连续取得建筑收益的一方——天辉承受住了反击，并在最后一轮买活决战后完成终结。"]}], "verdict": "", "reportVersion": 3, "editorialReviewed": true}}, "9074551016": {"match_id": 9074551016, "leagueid": 18113, "start_time": 1793715872, "duration": 905, "radiant_win": true, "radiant_score": 22, "dire_score": 5, "version": 22, "players": [{"account_id": 129989163, "personaname": "鵇", "name": null, "hero_id": 5, "player_slot": 0, "kills": 4, "deaths": 0, "assists": 12, "gold_per_min": 258, "xp_per_min": 398, "last_hits": 10, "denies": 4, "net_worth": 3973, "hero_damage": 8136, "tower_damage": 308, "hero_healing": 0, "obs_placed": 0, "sen_placed": 1, "stuns": 44.899902, "level": 10, "hero_name": "水晶室女", "position": "4号位", "positionSource": "分路推断", "rating": 52.5}, {"account_id": 216483167, "personaname": "MOMO", "name": null, "hero_id": 136, "player_slot": 1, "kills": 5, "deaths": 3, "assists": 7, "gold_per_min": 453, "xp_per_min": 431, "last_hits": 80, "denies": 6, "net_worth": 6792, "hero_damage": 7599, "tower_damage": 229, "hero_healing": 19, "obs_placed": 3, "sen_placed